{
  "manifest_version": 3,
  "name": "SentinelX",
  "version": "1.2.0",
  "description": "AI agent that scans job pages, matches your resume, and auto-fills Easy Apply forms",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "contextMenus",
    "webNavigation",
    "action"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["eadump.js", "easyapply.js"],
      "matches":   ["*://*.linkedin.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.myworkdayjobs.com/*",
        "*://*/careers/*",
        "*://*/jobs/*",
        "*://*/job/*",
        "*://*/apply/*",
        "*://*/opening/*",
        "*://*/position/*",
        "*://linkedin.com/jobs/*",
        "*://*.linkedin.com/jobs/*",
        "*://indeed.com/*",
        "*://*.indeed.com/*",
        "*://glassdoor.com/*",
        "*://*.glassdoor.com/*",
        "*://naukri.com/*",
        "*://*.naukri.com/*",
        "*://lever.co/*",
        "*://greenhouse.io/*",
        "*://*.greenhouse.io/*",
        "*://workable.com/*",
        "*://*.workable.com/*",
        "*://jobvite.com/*",
        "*://*.jobvite.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "/popup.html",
    "default_title": "SentinelX"
  },
  "icons": {
    "16":  "icons/icon48.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac":     "Command+Shift+E"
      },
      "description": "Open SentinelX popup"
    }
  }
}